GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
# app/ocr_engine.py's tier-2 fallback when PaddleOCR/pytesseract are both
# unavailable/failed. Check https://console.groq.com/docs/models for the
# current vision-capable model ID if this one has been deprecated.
GROQ_VISION_MODEL=llama-3.2-11b-vision-instruct
# Path to the Tesseract binary for app/ocr_engine.py's pytesseract fallback.
# Only needed if `tesseract` isn't already on PATH -- on Windows this is
# common even when Tesseract IS installed, since the official installer
# doesn't always add it to PATH. Auto-detected at
# C:\Program Files\Tesseract-OCR\tesseract.exe if left unset and that file
# exists; on Linux/Docker (see Dockerfile), installing the `tesseract-ocr`
# apt package already puts it on PATH and this isn't needed.
TESSERACT_CMD=
TESSERACT_LANG=eng+hin

# Module D (app/audio_engine.py) -- Bhashini ASR/TTS. Free tier, register at
# https://bhashini.gov.in. If left unset, transcribe_audio() raises a clear
# error (a transcript is never fabricated) and synthesize_speech() falls
# back to a mock silent WAV clip instead of blocking the kiosk flow.
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# Module E (app/database.py) -- offline session/queue persistence.
# Defaults to a local SQLite file if left unset.
DATABASE_URL=sqlite+aiosqlite:///./prakritidesk.db

# Module F (app/routes/auth.py) -- real ABDM Sandbox Gateway OTP flow for
# POST /auth/abha/init-otp + POST /auth/abha/verify-otp. If ABDM_CLIENT_ID/
# ABDM_CLIENT_SECRET are left unset (or the real call fails for any
# reason), this route falls back to a simulated OTP -- see that file's
# module docstring for important caveats about how unvalidated this
# integration is. SANDBOX DISCLAIMER: Simulated ABDM Gateway - Production
# requires certified M1/M2 CM-ID credentials.
ABDM_BASE_URL=https://dev.abdm.gov.in
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_CM_ID=sbx
ABDM_OTP_INIT_PATH=/gateway/v0.5/auth/init
ABDM_OTP_VERIFY_PATH=/gateway/v0.5/auth/confirm/with-mobile-otp
ABDM_ABHA_PROFILE_PATH=/gateway/v3/profile/account
