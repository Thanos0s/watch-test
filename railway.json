{
  "build": {
    "builder": "dockerfile",
    "dockerfilePath": "intake-engine/Dockerfile",
    "watchPatterns": ["intake-engine/**"]
  },
  "deploy": {
    "startCommand": "uvicorn app.main:app --host 0.0.0.0 --port ",
    "healthcheckPath": "/",
    "healthcheckTimeout": 30,
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 3
  }
}
